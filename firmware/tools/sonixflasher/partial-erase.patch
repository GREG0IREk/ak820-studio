 #include <stdint.h>
+#include <stdlib.h>
 #include <stdio.h>
 #include <unistd.h>
 
+/* SF_ERASE_PAGES=n : n'efface que les n premières pages (1 Ko chacune) au lieu de
+   toute la puce. L'EEPROM émulée du clavier est tout en haut de la mémoire : un
+   effacement complet détruit les réglages à chaque mise à jour. */
+uint16_t flash_erase_pages(const device_t *dev) {
+  const char *e = getenv("SF_ERASE_PAGES");
+  if (e) {
+    long n = strtol(e, NULL, 10);
+    if (n > 0 && n < dev->rom_pages)
+      return (uint16_t)n;
+  }
+  return dev->rom_pages;
+}
