diff --git a/src/usb_device_hidapi.c b/src/usb_device_hidapi.c
index 26f262d..dc65db3 100644
--- a/src/usb_device_hidapi.c
+++ b/src/usb_device_hidapi.c
@@ -1,3 +1,4 @@
+#include <stdio.h>
 #include "log.h"
 #include "usb_device.h"
 
@@ -49,7 +50,38 @@ void usb_device_exit(void) {
 }
 
 usb_device_t *usb_device_open(uint16_t vid, uint16_t pid) {
-  hid_device *handle = hid_open(vid, pid, NULL);
+  /* Windows : ouvrir de préférence une interface vendeur (usage page >= 0xFF00)
+     sans collections multiples ; SF_IFACE=n force le numéro d'interface. */
+  hid_device *handle = NULL;
+  /* SF_IFACE="8009:3" : interface imposée seulement pour ce PID */
+  const char *force = NULL;
+  int force_if = -1;
+  const char *fe = getenv("SF_IFACE");
+  if (fe) {
+    unsigned fpid = 0;
+    if (sscanf(fe, "%x:%d", &fpid, &force_if) == 2 && fpid == pid)
+      force = fe;
+  }
+  struct hid_device_info *devs = hid_enumerate(vid, pid), *d;
+  for (d = devs; d; d = d->next)
+    log_debug("HID %04x:%04x if=%d usage_page=0x%04x usage=0x%04x path=%s", d->vendor_id,
+              d->product_id, d->interface_number, d->usage_page, d->usage, d->path);
+  for (int pass = 0; pass < 3 && !handle; pass++) {
+    for (d = devs; d && !handle; d = d->next) {
+      bool col = d->path && (strstr(d->path, "&col") || strstr(d->path, "&COL"));
+      bool ok = force ? d->interface_number == force_if
+                      : (pass == 0 ? (d->usage_page >= 0xFF00 && !col)
+                                   : pass == 1 ? d->usage_page >= 0xFF00 : true);
+      if (!ok)
+        continue;
+      handle = hid_open_path(d->path);
+      if (handle)
+        log_info("Opened HID interface %d (usage page 0x%04x)", d->interface_number, d->usage_page);
+    }
+    if (force)
+      break;
+  }
+  hid_free_enumeration(devs);
   if (!handle)
     return NULL;
 
